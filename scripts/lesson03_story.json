    {
      "img": "story-02.png",
      "alt": "The friends pick berries on a short path near the cave",
      "lines": [
        { "role": "narrator", "text": "They walked a short way down the path and began to pick red berries.", "audio": "p02-01.mp3", "emotion": "happy" },
        { "role": "ember", "text": "These berries are yummy! I like helping.", "audio": "p02-02.mp3", "emotion": "happy" },
        { "role": "narrator", "text": "But the sky grew grey, and a cold wind brushed their faces.", "audio": "p02-03.mp3", "emotion": "worried" },

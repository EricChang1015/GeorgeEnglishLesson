        { "role": "george", "text": "Yes. Stay quiet. Don't run. That is very important.", "audio": "p04-04.mp3", "emotion": "whisper", "delivery": { "minimax_emotion": "fearful", "segments": [
          { "text": "Yes.", "speed": 1.17, "pitch": 0, "volume": 0.86 },

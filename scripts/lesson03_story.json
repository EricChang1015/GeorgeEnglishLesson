      ]
    },
    {
      "img": "story-03.png",
      "alt": "Thunder rolls as storm clouds gather",
      "lines": [
        { "role": "narrator", "text": "Far away, thunder rumbled like a giant drum.", "audio": "p03-01.mp3", "emotion": "worried" },
        { "role": "george", "text": "Is a storm coming, Pip?", "audio": "p03-02.mp3", "emotion": "worried", "delivery": { "minimax_emotion": "fearful", "segments": [
          { "text": "Is a storm coming,", "speed": 1.30, "pitch": 1 },
          { "text": "Pip?", "speed": 1.18, "pitch": 0, "volume": 0.86 }
        ] } },
        { "role": "pip", "text": "Yes. Let's take a few berries and go back to the cave soon.", "audio": "p03-03.mp3", "emotion": "worried" },
        { "role": "ember", "text": "I'm little. I can't fly in strong wind!", "audio": "p03-04.mp3", "emotion": "fearful" }
      ]
    },
    {

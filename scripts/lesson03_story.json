        { "role": "narrator", "text": "The bear ate a few berries, then walked slowly into the trees.", "audio": "p05-03.mp3", "emotion": "calm" },
        { "role": "george", "text": "My heart is beating fast, but we stayed quiet.", "audio": "p05-04.mp3", "emotion": "whisper", "delivery": { "minimax_emotion": "fearful", "segments": [
          { "text": "My heart is beating fast,", "speed": 1.23, "pitch": 1, "volume": 0.86 },
